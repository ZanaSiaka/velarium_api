generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  passwordHash          String
  role                  Role                   @default(COLLABORATEUR)
  image                 String?
  twoFactorEnabled      Boolean                @default(false)
  twoFactorSecret       String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  active                Boolean                @default(true)
  activityLogs          ActivityLog[]
  documentsDeposes      Document[]             @relation("DocumentUploadedBy")
  documentConsultations DocumentConsultation[]
  dossiersResponsable   Dossier[]              @relation("DossierAvocatResponsable")
  dossierCollaborations DossierCollaborateur[]
  evenementsCrees       Evenement[]            @relation("EvenementCreatedBy")
  tachesAssignees       Tache[]                @relation("TachesAssignees")
  tachesCreees          Tache[]                @relation("TachesCreees")
  contrats              ContratUtilisateur[]   @relation("UserContrats")
  pieces                PieceUtilisateur[]     @relation("UserPieces")
  mouvementsFinance     MouvementFinance[]
  piecesJointesFinance  PieceJointeFinance[]   @relation("FinancePieceUploadedBy")
}

model ContratUtilisateur {
  id String @id @default(cuid())

  userId String
  user   User   @relation("UserContrats", fields: [userId], references: [id], onDelete: Cascade)

  type TypeContrat

  dateDebut DateTime
  dateFin   DateTime?

  poste String?

  actif Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pieces PieceUtilisateur[]

  @@index([userId])
}

model PieceUtilisateur {
  id String @id @default(cuid())

  userId String
  user   User   @relation("UserPieces", fields: [userId], references: [id], onDelete: Cascade)

  contratId String?
  contrat   ContratUtilisateur? @relation(fields: [contratId], references: [id], onDelete: SetNull)

  type TypePieceUtilisateur

  nom String
  url String

  dateExpiration DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([contratId])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id        String     @id @default(cuid())
  type      ClientType @default(PARTICULIER)
  nom       String
  email     String?
  telephone String?
  adresse   String?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  dossiers  Dossier[]
  factures  Facture[]
}

model Dossier {
  id                    String                 @id @default(cuid())
  reference             String                 @unique
  type                  String?
  statut                DossierStatut          @default(EN_COURS)
  clientId              String
  avocatResponsableId   String
  juridiction           String?
  partieAdverse         String?
  dateOuverture         DateTime               @default(now())
  dateCloture           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  archive               Boolean                @default(false)
  archivedAt            DateTime?
  avocatClientEmail     String?
  avocatClientNom       String?
  avocatClientTelephone String?
  declarationSoupcon    String?
  kycSoupcon            Boolean                @default(false)
  natureAffaire         String?
  typeDossier           String?
  activityLogs          ActivityLog[]
  conventionsHonoraires ConventionHonoraires[]
  documents             Document[]
  avocatResponsable     User                   @relation("DossierAvocatResponsable", fields: [avocatResponsableId], references: [id])
  client                Client                 @relation(fields: [clientId], references: [id])
  collaborateurs        DossierCollaborateur[]
  evenements            Evenement[]
  factures              Facture[]
  provisions            Provision[]
  taches                Tache[]
  mouvementsFinance     MouvementFinance[]
}

model DossierCollaborateur {
  id        String   @id @default(cuid())
  dossierId String
  userId    String
  createdAt DateTime @default(now())
  dossier   Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dossierId, userId])
}

model Evenement {
  id          String        @id @default(cuid())
  title       String
  description String?
  start       DateTime
  end         DateTime?
  color       String?
  eventType   EvenementType @default(AUTRE)
  location    String?
  dossierId   String?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User          @relation("EvenementCreatedBy", fields: [createdById], references: [id])
  dossier     Dossier?      @relation(fields: [dossierId], references: [id])
}

model ConventionHonoraires {
  id                 String   @id @default(cuid())
  dossierId          String
  montantForfaitaire Decimal? @db.Decimal(14, 2)
  tauxHoraire        Decimal? @db.Decimal(14, 2)
  conditions         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  dossier            Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
}

model Facture {
  id           String        @id @default(cuid())
  numero       String        @unique
  statut       FactureStatut @default(BROUILLON)
  dossierId    String
  clientId     String
  dateEmission DateTime      @default(now())
  dateEcheance DateTime
  montantHT    Decimal       @db.Decimal(14, 2)
  tauxTVA      Decimal       @default(18) @db.Decimal(5, 2)
  montantTVA   Decimal       @db.Decimal(14, 2)
  montantTTC   Decimal       @db.Decimal(14, 2)
  mentionRCCM  String?
  mentionNCC   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  client     Client         @relation(fields: [clientId], references: [id])
  dossier    Dossier        @relation(fields: [dossierId], references: [id])
  lignes     LigneFacture[]
  paiements  Paiement[]
  provisions Provision[]
}

model LigneFacture {
  id           String  @id @default(cuid())
  factureId    String
  description  String
  quantite     Decimal @default(1) @db.Decimal(10, 2)
  prixUnitaire Decimal @db.Decimal(14, 2)
  montant      Decimal @db.Decimal(14, 2)
  facture      Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
}

model Paiement {
  id            String   @id @default(cuid())
  factureId     String
  montant       Decimal  @db.Decimal(14, 2)
  datePaiement  DateTime @default(now())
  moyenPaiement String?
  note          String?
  createdAt     DateTime @default(now())
  facture       Facture  @relation(fields: [factureId], references: [id], onDelete: Cascade)
}

model Provision {
  id            String   @id @default(cuid())
  dossierId     String
  factureId     String?
  montant       Decimal  @db.Decimal(14, 2)
  datePaiement  DateTime @default(now())
  moyenPaiement String?
  note          String?
  createdAt     DateTime @default(now())

  dossier Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  facture Facture? @relation(fields: [factureId], references: [id], onDelete: SetNull)

  @@index([dossierId])
  @@index([factureId])
  @@index([datePaiement])
}

model Document {
  id            String                 @id @default(cuid())
  nom           String
  dossierId     String
  storageKey    String
  url           String?
  taille        Int?
  type          String?
  visibilite    DocumentVisibilite     @default(INTERNE)
  uploadedById  String
  createdAt     DateTime               @default(now())
  dossier       Dossier                @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  uploadedBy    User                   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  consultations DocumentConsultation[]
}

model DocumentConsultation {
  id          String   @id @default(cuid())
  documentId  String
  userId      String
  consultedAt DateTime @default(now())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  dossierId  String?
  createdAt  DateTime @default(now())
  dossier    Dossier? @relation(fields: [dossierId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model Tache {
  id           String        @id @default(cuid())
  titre        String
  description  String?
  statut       TacheStatut   @default(A_FAIRE)
  priorite     TachePriorite @default(NORMALE)
  dateEcheance DateTime?
  createurId   String
  assigneAId   String
  dossierId    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  assigneA     User          @relation("TachesAssignees", fields: [assigneAId], references: [id])
  createur     User          @relation("TachesCreees", fields: [createurId], references: [id])
  dossier      Dossier?      @relation(fields: [dossierId], references: [id])

  @@index([assigneAId])
  @@index([createurId])
  @@index([dossierId])
  @@index([statut])
  @@index([dateEcheance])
}

model Caisse {
  id     String     @id @default(cuid())
  nom    String
  type   TypeCaisse
  devise String     @default("XOF")

  soldeInitial Decimal @default(0) @db.Decimal(15, 2)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mouvements         MouvementFinance[] @relation("CaisseMouvements")
  transfertsEntrants MouvementFinance[] @relation("CaisseDestination")
}

model MouvementFinance {
  id      String               @id @default(cuid())
  type    TypeMouvementFinance
  montant Decimal              @db.Decimal(15, 2)

  description String?
  categorie   CategorieFinance
  date        DateTime         @default(now())
  reference   String?
  pieceJointe String?

  // Caisse concernée
  caisseId String
  caisse   Caisse @relation("CaisseMouvements", fields: [caisseId], references: [id])

  // Utilisé uniquement pour les transferts
  caisseDestinationId String?
  caisseDestination   Caisse? @relation("CaisseDestination", fields: [caisseDestinationId], references: [id])

  // Utilisateur ayant enregistré l'opération
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Peut être rattaché à un dossier
  dossierId String?
  dossier   Dossier? @relation(fields: [dossierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  piecesJointes PieceJointeFinance[]

  @@index([caisseId])
  @@index([caisseDestinationId])
  @@index([userId])
  @@index([type])
  @@index([categorie])
  @@index([date])
  @@index([dossierId])
}

model PieceJointeFinance {
  id String @id @default(cuid())

  nom        String
  storageKey String  @unique
  taille     Int?
  type       String?

  mouvementId String
  mouvement   MouvementFinance @relation(fields: [mouvementId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("FinancePieceUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([mouvementId])
  @@index([uploadedById])
}

enum Role {
  AVOCAT
  COLLABORATEUR
  SECRETARIAT
  COMPTABLE
}

enum ClientType {
  PARTICULIER
  ENTREPRISE
}

enum DossierStatut {
  EN_COURS
  EN_ATTENTE
  CLOTURE
}

enum EvenementType {
  AUDIENCE
  DELAI
  DEPOT
  RENDEZ_VOUS
  AUTRE
}

enum FactureStatut {
  BROUILLON
  ENVOYEE
  PARTIELLEMENT_PAYEE
  PAYEE
  EN_RETARD
}

enum DocumentVisibilite {
  INTERNE
  VISIBLE_CLIENT
}

enum TacheStatut {
  A_FAIRE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum TachePriorite {
  BASSE
  NORMALE
  HAUTE
  URGENTE
}

enum TypeContrat {
  CDI
  CDD
  STAGE
  ALTERNANCE
  FREELANCE
  PRESTATION
  AUTRE
}

enum TypePieceUtilisateur {
  CNI
  PASSEPORT
  CONTRAT
  DIPLOME
  ATTESTATION
  CV
  PHOTO
  AUTRE
}

enum TypeCaisse {
  ESPECES
  BANQUE
  WAVE
  AUTRE
}

enum TypeMouvementFinance {
  ENTREE
  SORTIE
  TRANSFERT
}

enum CategorieFinance {
  HONORAIRES
  PAIEMENT_FACTURE
  PROVISION
  REMBOURSEMENT
  DEPOT
  RETRAIT
  ACHAT
  FOURNITURES
  SALAIRES
  LOYER
  ELECTRICITE
  INTERNET
  TRANSPORT
  FRAIS_BANCAIRES
  IMPOTS_TAXES
  AUTRE
}
